NODE_ENV=development
PORT=4000
CORS=http://localhost:3000

# ─── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# Or individual local parameters (if DATABASE_URL not set):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=padosi_pro

# ─── Authentication Secrets ───────────────────────────────────────────────────
JWT_ACCESS_TOKEN_SECRET_KEY=change_me_access_secret_at_least_32_chars
JWT_REFRESH_TOKEN_SECRET_KEY=change_me_refresh_secret_at_least_32_chars
JWT_ACCESSTOKEN_EXPIRY=15m
JWT_REFRESHTOKEN_EXPIRY=7d
COOKIE_SECRET=change_me_cookie_secret_at_least_32_chars

# ─── Hostinger Mail REST API ──────────────────────────────────────────────────
# Get mailbox ID and token from: https://api.mail.hostinger.com
HOSTINGER_MAILBOX_ID=your_mailbox_id_here
HOSTINGER_API_TOKEN=your_api_token_here
