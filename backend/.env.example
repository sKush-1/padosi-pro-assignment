NODE_ENV=development
PORT=4000
CORS=http://localhost:3000

# ─── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
# Use either full connection string (recommended for cloud like Neon/Supabase):
DATABASE_URL=postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# Or individual local parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=padosi_pro

# ─── Authentication Secrets ───────────────────────────────────────────────────
JWT_ACCESS_TOKEN_SECRET_KEY=change_me_access_secret_at_least_32_chars
JWT_REFRESH_TOKEN_SECRET_KEY=change_me_refresh_secret_at_least_32_chars
JWT_ACCESSTOKEN_EXPIRY=15m
JWT_REFRESHTOKEN_EXPIRY=7d

COOKIE_SECRET=change_me_cookie_secret_at_least_32_chars

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=support@bulkparser.com
EMAIL_PASS=your_email_password
EMAIL_FROM="Padosi Pro" <support@bulkparser.com>
