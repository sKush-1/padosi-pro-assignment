{
  "name": "padosi-pro-backend",
  "version": "1.0.0",
  "description": "Padosi Pro backend API — Node.js, Fastify, TypeScript, PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
